{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mpsccurrentaffairs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "chalughadamodi.in",
      "custom_domain": true
    },
    {
      "pattern": "veronica.chalughadamodi.in",
      "custom_domain": true
    },
    {
      "pattern": "mpsccurrentaffairs.in",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "chalughadamodi-images"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chalughadamodi-db",
      "database_id": "a4e6f551-c242-4eef-82ab-5ef7428e1da2",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_PASSWORD": "3103@moL..**",
    "GOOGLE_SITE_VERIFICATION": "W-T-sp-qvFNp_4EvsfZrVBdYU8ppOWF8qVDWBl6FQ1A",
    "GOOGLE_SITE_VERIFICATION_MPSC": "OBz7y9gz0xSkB80yxSyFv_gypHJ37M6opGFH7V8RJeo"
  }
}