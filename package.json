{
  "name": "chalughadamodi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "build:ios": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath build-mobile/ios CODE_SIGNING_ALLOWED=NO build && mkdir -p dist-mobile && cp -R build-mobile/ios/Build/Products/Debug-iphonesimulator/App.app dist-mobile/ && cd dist-mobile && zip -rq chalughadamodi-ios.zip App.app",
    "build:apk": "JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home ./android/gradlew --project-dir android assembleDebug && mkdir -p dist-mobile && cp android/app/build/outputs/apk/debug/app-debug.apk dist-mobile/chalughadamodi.apk"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@microsoft/clarity": "^1.0.2",
    "@opennextjs/cloudflare": "^1.19.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "sortablejs": "^1.15.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^4.20260508.1",
